POSTGRES_DB=study
POSTGRES_USER=study
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgres://study:change-this-local-password@localhost:15402/study
PORT=3102
# Claude API key used for the Korean translation of exercises (#31). If left empty, only translation requests fail.
# Local development reads the shared key from project-standards/.env (npm run dev), so leave it empty here.
# The production server reads it from AWS SSM at deploy time (project-standards ADR-0010).
ANTHROPIC_API_KEY=

# Public Data Portal key used to decide holidays for schedules (#33). If left empty, only creating a schedule for a year with no saved holidays fails.
# The server deploy and `node tools/app-secrets.mjs pull study-log` in project-standards read it from AWS SSM (#129).
# @desc Public Data Portal auth key (Decoding) for holiday lookup @secret @used=backend @ssm=/sirloinbh/shared/data-go-kr-service-key
HOLIDAY_API_KEY=

# The solved.ac handle whose solved Baekjoon problems the coding log imports (#369). Not a secret. If empty, only the import fails.
# @desc solved.ac handle to import solved Baekjoon problems from @used=backend
SOLVEDAC_HANDLE=

# The LeetCode username whose recent accepted submissions the coding log imports (#370). Not a secret. If empty, only the import fails.
# @desc LeetCode username to import recent accepted submissions from @used=backend
LEETCODE_USERNAME=

# Google Calendar one-way sync (#366). Create the OAuth client first (#367). If any is empty, only the sync is unavailable.
# GOOGLE_REDIRECT_URI is the address of /api/calendar-sync/callback on the site, as set on the OAuth client.
# CALENDAR_TOKEN_KEY encrypts the saved Google refresh token: 32 random bytes in base64 (`openssl rand -base64 32`).
# @desc Google OAuth client ID for the calendar sync @used=backend
GOOGLE_CLIENT_ID=
# @desc Google OAuth client secret for the calendar sync @secret @used=backend
GOOGLE_CLIENT_SECRET=
# @desc Address of the calendar sync callback (https://<site>/api/calendar-sync/callback) @used=backend
GOOGLE_REDIRECT_URI=
# @desc Key (32 random bytes, base64) that encrypts the saved Google refresh token @secret @used=backend
CALENDAR_TOKEN_KEY=

# S3 bucket and region for the original files of exercises and answers (#28). If either is empty, only file requests fail.
# Credentials follow the AWS SDK default chain: the keys below locally, the IAM role on the server (leave them empty there).
FILE_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Daily review reminder email through AWS SES (#365): one email at 08:00 Asia/Seoul on a day with reviews due. Off unless both
# addresses are set. REMINDER_EMAIL_FROM must be a sender verified in SES. SES_REGION falls back to AWS_REGION; credentials follow
# the AWS SDK default chain (the server's IAM role needs ses:SendEmail).
# @desc Address that receives the daily review reminder @used=backend
REMINDER_EMAIL_TO=
# @desc SES-verified sender address of the review reminder @used=backend
REMINDER_EMAIL_FROM=
# @desc AWS region of SES for the review reminder (falls back to AWS_REGION) @used=backend
SES_REGION=

# Address and port to publish the web port on. Keep the defaults locally. The production server .env sets WEB_BIND=0.0.0.0,
# and the deployment script health check uses the same WEB_PORT. Do not set IMAGE_TAG here; the deployment script sets it from the commit.
WEB_BIND=127.0.0.1
WEB_PORT=8102

# Where the API checks sign-in sessions (the shared sign-in, sirloinbh/shared-auth, #221). compose.yaml defaults to
# http://shared-auth-api:3110 on the shared-auth network. Leave it unset for local development without the sign-in;
# production refuses to start without it.
AUTH_INTERNAL_URL=
# shared-ai's Ed25519 public key (PEM, one line with \n escapes). Set: the API serves its AI tools at /internal/tools; empty: no tools.
# The server deploy reads it from SSM. @secret @ssm=/sirloinbh/shared/ai-tools-public-key
AI_TOOLS_PUBLIC_KEY=
