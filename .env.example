POSTGRES_DB=study
POSTGRES_USER=study
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgres://study:change-this-local-password@localhost:15402/study
PORT=3102
# Claude API key used for the Korean translation of exercises (#31). If left empty, only translation requests fail.
# Local development reads the shared key from project-standards/.env (npm run dev), so leave it empty here.
# The production server reads it from AWS SSM at deploy time (project-standards ADR-0010).
ANTHROPIC_API_KEY=

# Public Data Portal key used to decide holidays for schedules (#33). If left empty, only creating a schedule for a year with no saved holidays fails.
# The server deploy and `node tools/app-secrets.mjs pull study-log` in project-standards read it from AWS SSM (#129).
# @desc Public Data Portal auth key (Decoding) for holiday lookup @secret @used=backend @ssm=/sirloinbh/shared/data-go-kr-service-key
HOLIDAY_API_KEY=

# S3 bucket and region for the original files of exercises and answers (#28). If either is empty, only file requests fail.
# Credentials follow the AWS SDK default chain: the keys below locally, the IAM role on the server (leave them empty there).
FILE_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Address and port to publish the web port on. Keep the defaults locally. The production server .env sets WEB_BIND=0.0.0.0,
# and the deployment script health check uses the same WEB_PORT. Do not set IMAGE_TAG here; the deployment script sets it from the commit.
WEB_BIND=127.0.0.1
WEB_PORT=8102

# Where the API checks sign-in sessions (the shared sign-in, sirloinbh/shared-auth, #221). compose.yaml defaults to
# http://shared-auth-api:3110 on the shared-auth network. Leave it unset for local development without the sign-in;
# production refuses to start without it.
AUTH_INTERNAL_URL=
