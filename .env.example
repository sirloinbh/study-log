POSTGRES_DB=study
POSTGRES_USER=study
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgres://study:change-this-local-password@localhost:15402/study
PORT=3102
# 연습문제 한글 번역(#31)에 쓰는 Claude API 키. 비워 두면 번역 요청만 실패한다.
# 로컬 개발은 공용 키를 project-standards/.env에서 읽으므로(npm run dev) 여기는 비워 둔다.
# 운영 서버는 배포 때 AWS SSM에서 읽는다(project-standards ADR-0010).
ANTHROPIC_API_KEY=

# 일정의 공휴일 판정(#33)에 쓰는 공공데이터포털 키. 비워 두면 저장된 공휴일이 없는 연도의 일정 생성만 실패한다.
HOLIDAY_API_KEY=

# 웹 포트를 게시할 주소와 포트. 로컬은 기본값 그대로 둔다. 운영 서버 .env는 WEB_BIND=0.0.0.0으로 정하고,
# 배포 스크립트의 헬스체크도 같은 WEB_PORT로 확인한다. IMAGE_TAG는 배포 스크립트가 커밋으로 정하므로 적지 않는다.
WEB_BIND=127.0.0.1
WEB_PORT=8102
