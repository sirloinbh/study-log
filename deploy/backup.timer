# 중앙 관리 파일. 수정은 sirloinbh/project-standards의 templates/app/deploy/에서
[Unit]
Description=Dump the study-log database every night

[Timer]
# 03:30 Seoul, after the 03:00 Lightsail snapshot. Apps take turns through /run/lock/apps-backup.lock.
OnCalendar=*-*-* 03:30:00 Asia/Seoul
# Runs at the next boot when the server was off at that time.
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
