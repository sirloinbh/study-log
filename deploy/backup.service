# 중앙 관리 파일. 수정은 sirloinbh/project-standards의 templates/app/deploy/에서
[Unit]
Description=공부 기록 daily database dump (and S3 copy when configured)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/study-log
# Copied first: a deploy may check out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/study-log/deploy/backup.sh /tmp/study-backup.sh && exec /bin/bash /tmp/study-backup.sh dump'
TimeoutStartSec=30min
Nice=10
