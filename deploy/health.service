# Managed file. Edit it in sirloinbh/project-standards templates/app/deploy/
[Unit]
Description=Study Log health check signal for healthchecks.io
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/study-log
# Copied first: a deploy may check out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/study-log/deploy/notify.sh /tmp/study-notify.sh && exec /bin/bash /tmp/study-notify.sh health'
TimeoutStartSec=2min
