# Managed file. Edit it in sirloinbh/project-standards templates/app/deploy/
[Unit]
Description=Study Log daily server report for healthchecks.io
After=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/study-log
# Copied first: a deploy may check out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/study-log/deploy/report.sh /tmp/study-report.sh && exec /bin/bash /tmp/study-report.sh'
TimeoutStartSec=5min
