# Managed file. Edit it in sirloinbh/project-standards templates/app/deploy/
[Unit]
Description=Study Log pull-based deployment of origin/main
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/study-log
# Copied first: the deploy checks out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/study-log/deploy/autodeploy.sh /tmp/study-autodeploy.sh && exec /bin/bash /tmp/study-autodeploy.sh'
TimeoutStartSec=45min
Nice=10
