# Managed file. Edit it in sirloinbh/project-standards templates/app/deploy/
[Unit]
Description=Restore the newest study-log dump into a throwaway database every week

[Timer]
# Sunday 04:30 Seoul, after the nightly dumps. The result is in journalctl -u study-restore-check.
OnCalendar=Sun *-*-* 04:30:00 Asia/Seoul
Persistent=true
AccuracySec=5min

[Install]
WantedBy=timers.target
